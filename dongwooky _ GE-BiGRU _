l name is in the file names; epoch times are recorded.\n# ==============================================================================\n# Cell 5: Deterministic Model Training\n# ==============================================================================\n\nimport random\nimport time\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom tqdm.auto import tqdm\n\n# Fix Random Seeds\ndef set_seed(seed=42):\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n    torch.backends.cudnn.deterministic = True\n    torch.backends.cudnn.benchmark = False\n\nset_seed(42)\n\nMODEL_SAVE_PATH = f\"{OUTPUT_DIR}/ge_bigru_{TAG}_epoch{EPOCHS}.pt\"\nCKPT_PATH = f\"{OUTPUT_DIR}/ckpt_{TAG}.pt\"\n\nmodel = build_model(MODEL_NAME)\ncriterion = nn.MSELoss()\n\noptimizer = optim.AdamW(model.parameters())        # PATCH: authors' defaults\n\nstart_epoch, loss_history, epoch_times = 1, [], []\nif os.path.exists(CKPT_PATH):                       # PATCH: resume after an interrupted session\n    ck = torch.load(CKPT_PATH, map_location=DEVICE)\n    model.load_state_dict(ck[\"model\"])\n    optimizer.load_state_dict(ck[\"optimizer\"])\n    start_epoch, loss_history, epoch_times = ck[\"epoch\"] + 1, ck[\"loss_history\"], ck[\"epoch_times\"]\n    print(f\"Resuming {MODEL_NAME} from epoch {start_epoch}\")\n\nprint(f\"Starting Training of {MODEL_NAME} (Seed=42, Epochs={EPOCHS})...\\n\")\n\nfor epoch in range(start_epoch, EPOCHS + 1):\n\n    model.train()\n    train_loss = 0.0\n    t0 = time.time()\n\n    progress_bar = tqdm(\n        train_loader,\n        desc=f\"Epoch {epoch:02d}/{EPOCHS} [Training]\"\n    )\n\n    for batch_X, batch_Y in progress_bar:\n\n        batch_X = batch_X.to(DEVICE, non_blocking=True)\n        batch_Y = batch_Y.to(DEVICE, non_blocking=True)\n\n        optimizer.zero_grad()\n\n        preds = model(batch_X, edge_index)\n        loss = criterion(preds, batch_Y)\n\n        loss.backward()\n        optimizer.step()\n\n        train_loss += loss.item() * len(batch_X)\n\n        progress_bar.set_postfix(loss=f\"{loss.item():.6f}\")\n\n    train_loss /= len(train_loader.dataset)\n    loss_history.append(train_loss)\n    epoch_times.append(time.time() - t0)\n\n    torch.save({\"model\": model.state_dict(), \"optimizer\": optimizer.state_dict(), \"epoch\": epoch,\n                \"loss_history\": loss_history, \"epoch_times\": epoch_times}, CKPT_PATH)\n\n    if epoch % 10 == 0 or epoch == 1:\n        print(\n            f\"Epoch {epoch:02d}/{EPOCHS} | \"\n            f\"Train MSE Loss: {train_loss:.6f} | {epoch_times[-1]:.0f}s\"\n        )\n\n# Save final weights\ntorch.save(model.state_dict(), MODEL_SAVE_PATH)\n\nprint(f\"\\nTraining Complete!\")\nprint(f\"Saved final checkpoint to: {MODEL_SAVE_PATH}\")\nprint(f\"Training time: {sum(epoch_times) / 60:.1f} min ({np.mean(epoch_times):.0f} s/epoch)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:03:32.017324Z","iopub.execute_input":"2026-11-04T14:03:32.017643Z","iopub.status.idle":"2026-11-04T14:03:32.073505Z","shell.execute_reply.started":"2026-11-04T14:03:32.017619Z","shell.execute_reply":"2026-11-04T14:03:32.072789Z"}},"outputs":[{"name":"stdout","text":"Resuming Bi-GRU+GNN from epoch 71\nStarting Training of Bi-GRU+GNN (Seed=42, Epochs=70)...\n\n\nTraining Complete!\nSaved final checkpoint to: /kaggle/working/ge_bigru_Bi-GRU_GNN_epoch70.pt\nTraining time: 85.3 min (73 s/epoch)\n","output_type":"stream"}],"execution_count":101},{"cell_type":"code","source":"import shutil, glob, os\nos.chdir(\"/kaggle/working\")\nfiles = glob.glob(\"ge_bigru_*.pt\") + glob.glob(\"ckpt_*.pt\") + glob.glob(\"result_*.json\") + [\"scaler.joblib\"]\nprint(\"saving:\", files)\nshutil.make_archive(\"/kaggle/working/ge_bigru_backup\", \"zip\", \"/kaggle/working\", logger=None) if False else None\nimport zipfile\nwith zipfile.ZipFile(\"/kaggle/working/ge_bigru_backup.zip\", \"w\", z