    <td>0</td>\n    </tr>\n    <tr>\n      <th>test5.csv</th>\n      <td>92401</td>\n      <td>92401</td>\n      <td>0</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"execution_count":89,"output_type":"execute_result","data":{"text/plain":"0"},"metadata":{}}],"execution_count":89},{"cell_type":"markdown","source":"## 8. Preprocessing pipeline\n\npipeline, which matches the paper (Section 3.2):\n\n1. **Min–max scaling** to [0, 1] with statistics from the **training set only**, reused for validation and test. (`MinMaxScaler` only shifts channels that are constant in training, like the authors' `normalize`.)\n   \n3. **Exponential moving average** with α = 0.9 (`ewm(alpha=0.9).mean()`), applied per file.\n\n   \n5. **Sliding window** of 40 steps, stride 1: 39 input steps and the 40th step as the prediction target.","metadata":{}},{"cell_type":"code","source":"\n# ==========================================\n# Normalization (Min-Max) & EMA\n# ==========================================\n\n# 1. Identify feature columns from the first training file\nfirst_train_path = os.path.join(DATA_DIR, TRAIN_FILES[0])\n\ndf_first = pd.read_csv(first_train_path)\n\nfeature_cols = [\n    c.strip() for c in df_first.columns\n    if c.strip() not in LABEL_COLS\n]\n\nprint(f\"Loaded {len(feature_cols)} feature channels.\")\n\ndel df_first\n\n\n# 2. Fit MinMaxScaler incrementally on training files only\nscaler = MinMaxScaler()\n\nfor f in TRAIN_FILES:\n\n    path = os.path.join(DATA_DIR, f)\n\n    if not os.path.exists(path):\n        raise FileNotFoundError(f\"Missing training file: {path}\")\n\n    print(f\"Fitting scaler on {f}...\")\n\n    df = pd.read_csv(path)\n\n    scaler.partial_fit(df[feature_cols].values)\n\n    del df\n\n\n# Save fitted scaler\njoblib.dump(scaler, SCALER_PATH)\n\nprint(f\"Saved fitted MinMaxScaler to: {SCALER_PATH}\")\n\n\n# 3. Scaling + EMA Smoothing\ndef preprocess_dataframe(df, feature_cols, scaler, alpha=0.9):\n\n    scaled_vals = scaler.transform(df[feature_cols].values)\n\n    df_scaled = pd.DataFrame(\n        scaled_vals,\n        columns=feature_cols\n    )\n\n    df_ema = df_scaled.ewm(alpha=alpha).mean()\n\n    return df_ema.values.astype(np.float32)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:03:04.475932Z","iopub.execute_input":"2026-11-04T14:03:04.476237Z","iopub.status.idle":"2026-11-04T14:03:14.766272Z","shell.execute_reply.started":"2026-11-04T14:03:04.476213Z","shell.execute_reply":"2026-11-04T14:03:14.765421Z"}},"outputs":[{"name":"stdout","text":"Loaded 79 feature channels.\nFitting scaler on train1.csv...\nFitting scaler on train2.csv...\nFitting scaler on train3.csv...\nSaved fitted MinMaxScaler to: /kaggle/working/scaler.joblib\n","output_type":"stream"}],"execution_count":90},{"cell_type":"code","source":"# ==============================================================================\n# Cell 3: Sliding Window Packaging (w=40: 39 Inputs -> 1 Target)\n# ==============================================================================\n\ndef create_windows_from_segment(data_array, window_size=40, stride=1):\n    \"\"\"Generates 3D sliding windows for a single continuous file segment.\n    X: First 39 timesteps (N, 39, 79) | Y: 40th timestep target (N, 79)\n    \"\"\"\n    num_samples = (len(data_array) - window_size) // stride + 1\n\n    if num_samples <= 0:\n        return np.empty(\n            (0, window_size - 1, data_array.shape[1]), dtype=np.float32\n        ), np.empty((0, data_array.shape[1]), dtype=np.float32)\n\n    shape_x = (num_samples, window_size - 1, data_array.shape[1])\n\n    strides_x = (\n        data_array.strides[0] * stride,\n        data_array.strides[0],\n        data_array.strides[1],\n    )\n\n    X = np.lib.stride_tricks.as_strided(\n        data_array, shape=shape_x, strides=strides_x\n    )\n\n    Y = data_array[\n        window_size - 1 : window_size - 1 + num_samples * stride : stride\n    ]\n\n    return np.copy(X), np.copy(Y)\n\n\ndef process_and_window_files(\n    file_paths, feature_cols, scaler, window_size=40, row_limit=None\n):\n    X_list, Y_list = [], []\n\n    for path in file_paths:\n        if not os.path.exists(path):\n            continue\n\n        df = pd.read_csv(path)\n\n        if row_limit:\n            df = df.iloc[:row_limit]\n\n        processed = preprocess_dataframe(\n            df, feature_cols, scaler, alpha=0.9\n        )\n\n        X_seg, Y_seg = create_windows_from_segment(\n            processed, window_size=window_size\n        )\n\n        X_list.append(X_seg)\n        Y_list.append(Y_seg)\n\n    return np.concatenate(X_list, axis=0), np.concatenate(Y_list, axis=0)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:03:14.767288Z","iopub.execute_input":"2026-11-04T14:03:14.767529Z","iopub.status.idle":"2026-11-04T14:03:14.776461Z","shell.execute_reply.started":"2026-11-04T14:03:14.767505Z","shell.execute_reply":"2026-11-04T14:03:14.775527Z"}},"outputs":[],"execution_count":91},{"cell_type":"code","source":"# [patch] Memory-efficient datasets and DataLoaders (your cell)\n# PATCH 1: each file is cleaned (Section 7) before preprocessing.\n# PATCH 2: files are split at time gaps, so no window spans a gap (the paper keeps only contiguous windows).\n# PATCH 3: load_processed_segments also returns, for every window, the row index of its target and the attack label of\n#          every row; Part 2 needs them to evaluate with eTaPR on full-length label sequences.\n# ==============================================================================\n# Cell 3b: Memory-Efficient Datasets and DataLoaders\n# ==============================================================================\n\nimport bisect\nimport torch\nfrom torch.utils.data import DataLoader, Dataset\n\n\n# 1. Process files individually and retain preprocessed segments\n\ntrain_paths = [\n    os.path.join(DATA_DIR, f) for f in TRAIN_FILES\n]\n\nval_paths = [\n    os.path.join(DATA_DIR, VAL_FILE)\n]\n\n\ndef load_processed_segments(file_paths, row_limit=None):\n\n    segments, target_idx, labels = [], [], []\n    offset = 0                                                    # global row index of the first row of the current file\n\n    for path in file_paths:\n\n        if not os.path.exists(path):\n            raise FileNotFoundError(f\"Missing file: {path}\")\n\n        print(f\"Processing: {os.path.basename(path)}\")\n\n        df = pd.read_csv(path)\n        df.columns = [c.strip() for c in df.columns]\n\n        if row_limit is not None:\n            df = df.iloc[:row_limit]\n\n        df, _ = clean_frame(df)                                   # PATCH 1\n\n        processed = preprocess_dataframe(\n            df,\n            feature_cols,\n            scaler,\n            alpha=0.9\n        )\n        processed = np.ascontiguousarray(processed, dtype=np.float32)\n\n        # PATCH 2: contiguous pieces (1 s apart); pieces shorter than a window cannot produce windows\n        t = df[\"time\"].to_numpy().astype(\"datetime64[s]\").astype(\"int64\")\n        cuts = np.flatnonzero(np.diff(t) != 1) + 1\n        bounds = np.concatenate([[0], cuts, [len(df)]])\n        for a, b in zip(bounds[:-1], bounds[1:]):\n            if b - a >= WINDOW:\n                segments.append(processed[a:b])\n                target_idx.append(offset + a + (WINDOW - 1) + np.arange(b - a - WINDOW + 1))   # PATCH 3\n\n        labels.append(df[\"attack\"].fillna(0).to_numpy())          # PATCH 3\n        print(f\"Loaded {len(processed):,} rows ({len(bounds) - 1} contiguous piece(s)).\")\n        offset += len(df)\n\n        del df, processed\n\n    return segments, np.concatenate(target_idx), np.concatenate(labels)\n\n\nprint(\"\\nProcessing Training Set...\")\n\ntrain_segments, train_target_idx, train_labels = load_processed_segments(train_paths)\n\nprint(\"\\nProcessing Validation Set...\")\n\nval_segments, val_target_idx, val_labels = load_processed_segments(\n    val_paths,\n    row_limit=43201\n)\n\n\n# 2. Define Lazy Sliding Window Dataset\n\nclass HAIDataset(Dataset):\n\n    def __init__(self, segments, window_size=40):\n\n        self.segments = [\n            torch.from_numpy(segment)\n            for segment in segments\n        ]\n\n        self.window_size = window_size\n\n        self.segment_lengths = [\n            len(segment) - window_size + 1\n            for segment in self.segments\n        ]\n\n        self.cumulative_lengths = np.cumsum(\n            self.segment_lengths\n        ).tolist()\n\n        self.total_samples = sum(self.segment_lengths)\n\n    def __len__(self):\n        return self.total_samples\n\n    def __getitem__(self, idx):\n\n        # Identify which file contains this sample\n        segment_idx = bisect.bisect_right(\n            self.cumulative_lengths,\n            idx\n        )\n\n        previous_end = (\n            self.cumulative_lengths[segment_idx - 1]\n            if segment_idx > 0 else 0\n        )\n\n        local_idx = idx - previous_end\n\n        segment = self.segments[segment_idx]\n\n        # First 39 timesteps = Input\n        X = segment[\n            local_idx : local_idx + self.window_size - 1\n        ]\n\n        # 40th timestep = Target\n        Y = segment[\n            local_idx + self.window_size - 1\n        ]\n\n        return X, Y\n\n\n# 3. Create Datasets\n\ntrain_dataset = HAIDataset(\n    train_segments,\n    window_size=40\n)\n\nval_dataset = HAIDataset(\n    val_segments,\n    window_size=40\n)\n\n\n# 4. Create DataLoaders\n\ntrain_loader = DataLoader(\n    train_dataset,\n    batch_size=512,\n    shuffle=True,\n    drop_last=True,\n    pin_memory=True\n)\n\nval_loader = DataLoader(\n    val_dataset,\n    batch_size=512,\n    shuffle=False,\n    pin_memory=True\n)\n\n\n# 5. Dataset Summary\n\nprint(\"\\nDataLoaders Ready!\")\n\nprint(f\"Training Samples: {len(train_dataset):,}\")\nprint(f\"Validation Samples: {len(val_dataset):,}\")\n\nprint(f\"Training Batches: {len(train_loader):,}\")\nprint(f\"Validation Batches: {len(val_loader):,}\")\n\nprint(f\"Input Shape: (39, {len(feature_cols)})\")\nprint(f\"Target Shape: ({len(feature_cols)},)\")\n\ntest_paths = [os.path.join(DATA_DIR, f) for f in TEST_FILES]\n\nprint(\"\\nProcessing Test Set...\")\ntest_segments, test_target_idx, test_labels = load_processed_segments(test_paths)\n\ntest_dataset = HAIDataset(test_segments, window_size=40)\n\ntest_loader = DataLoader(\n    test_dataset,\n    batch_size=512,\n    shuffle=False,\n    pin_memory=True\n)\n\nprint(f\"Test Samples: {len(test_dataset):,}\")\nprint(f\"Test Batches: {len(test_loader):,}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:03:14.777749Z","iopub.execute_input":"2026-11-04T14:03:14.77816Z","iopub.status.idle":"2026-11-04T14:03:30.940819Z","shell.execute_reply.started":"2026-11-04T14:03:14.778135Z","shell.execute_reply":"2026-11-04T14:03:30.939986Z"}},"outputs":[{"name":"stdout","text":"\nProcessing Training Set...\nProcessing: train1.csv\nLoaded 216,001 rows (1 contiguous piece(s)).\nProcessing: train2.csv\nLoaded 226,801 rows (1 contiguous piece(s)).\nProcessing: train3.csv\nLoaded 478,801 rows (1 contiguous piece(s)).\n\nProcessing Validation Set...\nProcessing: test1.csv\nLoaded 43,201 rows (1 contiguous piece(s)).\n\nDataLoaders Ready!\nTraining Samples: 921,486\nValidation Samples: 43,162\nTraining Batches: 1,799\nValidation Batches: 85\nInput Shape: (39, 79)\nTarget Shape: (79,)\n\nProcessing Test Set...\nProcessing: test2.csv\nLoaded 118,801 rows (1 contiguous piece(s)).\nProcessing: test3.csv\nLoaded 108,001 rows (1 contiguous piece(s)).\nProcessing: test4.csv\nLoaded 39,601 rows (1 contiguous piece(s)).\nProcessing: test5.csv\nLoaded 92,401 rows (1 contiguous piece(s)).\nTest Samples: 358,648\nTest Batches: 701\n","output_type":"stream"}],"execution_count":92},{"cell_type":"markdown","source":"## 9. Feature selection and the sensor graph\n\nThe paper keeps **all 79 channels** and encodes sensor relationships as a **fixed binary adjacency matrix from the testbed's P&ID** (piping and instrumentation diagrams).\n\n`A[i, j] = 1` means a direct process-flow path from node *i* to node *j* (rows are sources, as in the paper's Fig. 1 and in the authors' `edge_index = A.nonzero().t()`).\n\nThis section analyses the graph, **tests that argument on the data**, and records which channels deserve attention.","metadata":{}},{"cell_type":"code","source":"# ==========================================\n# Cell 1: Load and Validate Adjacency Matrix\n# ==========================================\n\ndf_adj = pd.read_csv(GRAPH_PATH)\nA = df_adj.values.astype(np.float32)\n\nif A.shape[0] != A.shape[1]:\n    raise ValueError(\"Adjacency matrix must be square.\")\n\nnodes = [\n    col for col in pd.read_csv(\n        os.path.join(DATA_DIR, TRAIN_FILES[0]), nrows=0\n    ).columns\n    if col not in LABEL_COLS\n]\n\nif len(nodes) != A.shape[0]:\n    raise ValueError(\n        f\"Feature count ({len(nodes)}) does not match graph size ({A.shape[0]}).\"\n    )\n\n# Remove self-loops for visualization\nA_no_loops = A.copy()\nnp.fill_diagonal(A_no_loops, 0)\n\n# Reconstruct directed graph\nG = nx.from_numpy_array(A_no_loops.T, create_using=nx.DiGraph)\nG = nx.relabel_nodes(G, {i: name for i, name in enumerate(nodes)})\n\n# Count clusters\nclusters = list(nx.weakly_connected_components(G))\n\nprint(f\"Loaded adjacency matrix: {A.shape}\")\nprint(f\"Directed edges (excluding self-loops): {int(A_no_loops.sum())}\")\nprint(\"Number of clusters:\", len(clusters))\nprint(\"Clusters with more than one node:\", sum(len(c) > 1 for c in clusters))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:03:30.941998Z","iopub.execute_input":"2026-11-04T14:03:30.942367Z","iopub.status.idle":"2026-11-04T14:03:30.966931Z","shell.execute_reply.started":"2026-11-04T14:03:30.942331Z","shell.execute_reply":"2026-11-04T14:03:30.966144Z"}},"outputs":[{"na