ENTS = {\"test1.csv\": 5, \"test2.csv\": 20, \"test3.csv\": 8, \"test4.csv\": 5, \"test5.csv\": 12}  # HAI 21.03 documentation\nINTRA = {\"test1.csv\": 0, \"test2.csv\": 0, \"test3.csv\": 5, \"test4.csv\": 1, \"test5.csv\": 5}         # intra-process combined (HAI table)\n\n\ndef get_attack_events(df):\n    \"\"\"Event id for each contiguous run of attack rows (NaN outside attacks).\"\"\"\n    flag = df[\"attack\"].fillna(0).gt(0)\n    return (flag & ~flag.shift(1, fill_value=False)).cumsum().where(flag)\n\n\n# Load the label columns of every file once (also reused by the splits table below)\nlab = {}\nfor f in TRAIN_FILES + ALL_TEST:\n    d = pd.read_csv(os.path.join(DATA_DIR, f), usecols=lambda c: c.strip() in LABEL_COLS)\n    d.columns = [c.strip() for c in d.columns]\n    d[\"time\"] = pd.to_datetime(d[\"time\"])\n    for c in LABEL_COLS[1:]:\n        if c not in d.columns:\n            d[c] = 0\n    lab[f] = d\n\nev = {f: get_attack_events(lab[f]) for f in ALL_TEST}\n\n# Attack types per test file\nrows = []\nfor f in TEST_FILES:\n    active = lab[f][P_COLS].fillna(0).gt(0).groupby(ev[f]).any()   # which processes each event touches\n    n_active = active.sum(axis=1)\n    intra = INTRA[f]\n    rows.append({\n        \"file\": f,\n        \"P1\": int(active[\"attack_P1\"].sum()),\n        \"P2\": int(active[\"attack_P2\"].sum()),\n        \"P3\": int(active[\"attack_P3\"].sum()),\n        \"single\": int((n_active == 1).sum()) - intra,\n        \"combined Inter-Process\": int((n_active >= 2).sum()),\n        \"combined Intra-Process\": intra,\n        \"unlabeled\": int((n_active == 0).sum()),\n        \"all\": int(ev[f].nunique()),\n        \"documented\": DOC_EVENTS[f],\n    })\n\nresult = pd.DataFrame(rows).set_index(\"file\").astype(\"Int64\")\nresult.loc[\"TOTAL\"] = result.sum()\ndisplay(result)\n\n# Class balance (test1-5)\nn_test = sum(len(lab[f]) for f in ALL_TEST)\natt_test = sum(int(ev[f].notna().sum()) for f in ALL_TEST)\nprint(f\"Test anomaly ratio: {100 * att_test / n_test:.2f}% attack rows vs {100 - 100 * att_test / n_test:.2f}% normal rows\")\n\nplt.figure(figsize=(4, 4))\nplt.pie([n_test - att_test, att_test], labels=[\"normal\", \"attack\"], autopct=\"%1.2f%%\",\n        colors=[\"#9ecae1\", \"#d62728\"], startangle=90)\nplt.title(\"Test set class balance (test1-5)\")\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:02:27.907625Z","iopub.execute_input":"2026-11-04T14:02:27.908087Z","iopub.status.idle":"2026-11-04T14:02:34.623623Z","shell.execute_reply.started":"2026-11-04T14:02:27.908047Z","shell.execute_reply":"2026-11-04T14:02:34.623077Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"           P1  P2  P3  single  combined Inter-Process  combined Intra-Process  \\\nfile                                                                            \ntest2.csv  12   6   2      20                       0                       0   \ntest3.csv   6   5   0       0                       3                       5   \ntest4.csv   4   2   3       0                       4                       1   \ntest5.csv   9   7   3       0                       7                       5   \nTOTAL      31  20   8      20                      14                      11   \n\n           unlabeled  all  documented  \nfile                                   \ntest2.csv          0   20          20  \ntest3.csv          0    8           8  \ntest4.csv          0    5           5  \ntest5.csv          0   12          12  \nTOTAL              0   45          45  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>P1</th>\n      <th>P2</th>\n      <th>P3</