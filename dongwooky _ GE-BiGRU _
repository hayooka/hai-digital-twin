")\nprint(f\"Model: {MODEL_NAME} | epochs: {EPOCHS} | device: {DEVICE}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:03:31.91156Z","iopub.execute_input":"2026-11-04T14:03:31.911939Z","iopub.status.idle":"2026-11-04T14:03:31.917455Z","shell.execute_reply.started":"2026-11-04T14:03:31.911899Z","shell.execute_reply":"2026-11-04T14:03:31.916631Z"}},"outputs":[{"name":"stdout","text":"Model: Bi-GRU+GNN | epochs: 70 | device: cuda\n","output_type":"stream"}],"execution_count":97},{"cell_type":"code","source":"import subprocess, sys\ntry:\n    import torch_geometric\nexcept ImportError:\n    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"torch_geometric\"], check=True)\n    import torch_geometric\nprint(\"torch_geometric\", torch_geometric.__version__)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:03:31.919191Z","iopub.execute_input":"2026-11-04T14:03:31.91956Z","iopub.status.idle":"2026-11-04T14:03:31.932374Z","shell.execute_reply.started":"2026-11-04T14:03:31.919505Z","shell.execute_reply":"2026-11-04T14:03:31.931661Z"}},"outputs":[{"name":"stdout","text":"torch_geometric 2.8.1\n","output_type":"stream"}],"execution_count":98},{"cell_type":"code","source":"# ==============================================================================\n# Cell 4: Graph Ingestion (graph.csv) & Vectorized GE-BiGRU Model Architecture\n# ==============================================================================\n\nimport torch.nn as nn\nfrom torch_geometric.nn import GATConv, GCNConv\n\n\n# 1. Load adjacency matrix and convert it to edge_index\ndef load_edge_index(graph_path):\n\n    if not os.path.exists(graph_path):\n        raise FileNotFoundError(f\"Graph file not found: {graph_path}\")\n\n    adj_matrix = pd.read_csv(graph_path).values.astype(float)        # PATCH 1\n\n    src_nodes, tgt_nodes = adj_matrix.nonzero()\n\n    edge_index = torch.from_numpy(\n        np.stack([src_nodes, tgt_nodes], axis=0)\n    ).long()\n\n    adj = torch.from_numpy(adj_matrix).float()\n    adj_norm = adj / adj.sum(dim=1, keepdim=True).clamp(min=1e-6)    # D^-1 A, used by the \"gnn\" variant\n\n    print(\n        f\"Loaded Graph Matrix: {adj_matrix.shape[0]} nodes, \"\n        f\"{edge_index.shape[1]} directed edges.\"\n    )\n\n    return edge_index, adj_norm\n\n\n# 2. GE-BiGRU Model Architecture\nclass GE_BiGRU(nn.Module):\n\n    def __init__(\n        self,\n        num_nodes=79,\n        in_timesteps=39,\n        hidden_dim=100,\n        num_rnn_layers=3,\n        graph_type=\"gat\",\n        bidirectional=True,\n        adj_norm=None,\n    ):\n\n        super().__init__()\n\n        self.num_nodes = num_nodes\n        self.in_timesteps = in_timesteps\n        self.graph_type = graph_type\n\n        # A. Spatial graph layer\n        if graph_type == \"gat\":\n            self.graph = GATConv(\n                in_channels=in_timesteps,\n                out_channels=in_timesteps,\n                heads=1,\n                concat=False,\n            )\n        elif graph_type == \"gcn\":\n            self.graph = GCNConv(in_timesteps, in_timesteps)\n        elif graph_type == \"gnn\":\n            self.register_buffer(\"adj_norm\", adj_norm)\n            self.graph = nn.Linear(in_timesteps, in_timesteps, bias=False)\n        else:\n            self.graph = None\n\n        # B. Temporal 3-Layer (Bi)directional GRU\n        self.rnn = nn.GRU(\n            input_size=num_nodes,\n            hidden_size=hidden_dim,\n            num_layers=num_rnn_layers,\n            batch_first=True,\n            bidirectional=bidirectional,\n        )\n\n        # C. Final Linear Projection\n        self.fc = nn.Linear(hidden_dim * (2 if bidirectional else 1), num_nodes)\n\n\n    def forward(self, x, edge_index=None):\n\n        # x: (Batch_Size, 39 timesteps, 79 channels)\n\n        batch_size, seq_len, num_nodes = x.shape\n\n        # --------------------------------------------------\n        # Step 1: Spatial graph transformation\n        # --------------------------------------------------\n\n        if self.graph_type in (\"gat\", \"gcn\"):\n\n            # (B, 39, 79) -> (B * 79, 39)\n            x_nodes = x.transpose(1, 2).reshape(-1, seq_len)\n\n            num_edges = edge_index.shape[1]\n\n            # Create separate graph indices for each batch sample\n            b_offsets = (\n                torch.arange(batch_size, device=x.device)\n                .repeat_interleave(num_edges)\n                * num_nodes\n            )\n\n            batched_edge_index = (\n                edge_index.repeat(1, batch_size) + b_offsets\n            )\n\n            # Apply the graph layer to the entire batch\n            graph_out = self.graph(\n                x_nodes,\n                batched_edge_index\n            )\n\n            # (B * 79, 39) -> (B, 39, 79)\n            x_spatial = (\n                graph_out.view(batch_size, num_nodes, seq_len)\n                .transpose(1, 2)\n            )\n\n        elif self.graph_type == \"gnn\":\n\n            # (B, 79, 39): each node aggregates its neighbours' 39-step series, then a learnable linear map\n            x_spatial = self.graph(self.adj_norm @ x.transpose(1, 2)).transpose(1, 2)\n\n        else:\n            x_spatial = x\n\n        # --------------------------------------------------\n        # Step 2: Temporal GRU processing\n        # --------------------------------------------------\n\n        rnn_out, _ = self.rnn(x_spatial)\n\n        # (B, 39, 200) for the bidirectional model\n        last_rnn_state = rnn_out[:, -1, :]\n\n        # --------------------------------------------------\n        # Step 3: Linear Projection + Residual Connection\n        # --------------------------------------------------\n\n        pred = self.fc(last_rnn_state)\n\n        # (B, 79); the residual is the first input step, exactly as in the authors' code\n        output = pred + x_spatial[:, 0, :]\n\n        return output\n\n\n# 3. Initialize Graph and Model\nedge_index, adj_norm = load_edge_index(GRAPH_PATH)\nedge_index, adj_norm = edge_index.to(DEVICE), adj_norm.to(DEVICE)\n\nMODEL_ZOO = {\"Bi-GRU\": \"none\", \"Bi-GRU+GNN\": \"gnn\", \"Bi-GRU+GCN\": \"gcn\", \"Bi-GRU+GAT\": \"gat\"}\n\ndef build_model(name):\n    return GE_BiGRU(\n        num_nodes=79, in_timesteps=39, hidden_dim=100, num_rnn_layers=3,\n        graph_type=MODEL_ZOO[name], bidirectional=True, adj_norm=adj_norm,\n    ).to(DEVICE)\n\nmodel = build_model(MODEL_NAME)\n\n# 4. Count Trainable Parameters\n\ntotal_params = sum(\n    p.numel()\n    for p in model.parameters()\n    if p.requires_grad\n)\n\nprint(f\"\\nDevice in use: {DEVICE}\")\nprint(f\"Total Trainable Parameters: {total_params:,}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:03:31.933444Z","iopub.execute_input":"2026-11-04T14:03:31.933779Z","iopub.status.idle":"2026-11-04T14:03:31.971726Z","shell.execute_reply.started":"2026-11-04T14:03:31.933741Z","shell.execute_reply":"2026-11-04T14:03:31.971116Z"}},"outputs":[{"name":"stdout","text":"Loaded Graph Matrix: 79 nodes, 112 directed edges.\n\nDevice in use: cuda\nTotal Trainable Parameters: 488,400\n","output_type":"stream"}],"execution_count":99},{"cell_type":"code","source":"PAPER_PARAMS = {\"Bi-GRU\": 486_879, \"Bi-GRU+GNN\": 488_400, \"Bi-GRU+GCN\": 488_439, \"Bi-GRU+GAT\": 488_517}\nrows = []\nfor name in MODEL_ZOO:\n    m = build_model(name)\n    n = sum(p.numel() for p in m.parameters() if p.requires_grad)\n    rows.append({\"model\": name, \"parameters\": n, \"paper (Table 6)\": PAPER_PARAMS[name], \"match\": n == PAPER_PARAMS[name]})\n    del m\ndisplay(pd.DataFrame(rows).set_index(\"model\"))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:03:31.972557Z","iopub.execute_input":"2026-11-04T14:03:31.972774Z","iopub.status.idle":"2026-11-04T14:03:32.016506Z","shell.execute_reply.started":"2026-11-04T14:03:31.972751Z","shell.execu