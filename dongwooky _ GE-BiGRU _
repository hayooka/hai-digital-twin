,"source":"## 4. Feature types\n\nAll 79 channels are numeric (sensor readings, valve/pump commands and states, setpoints).\n\nThey are profiled on the training data as constant, binary, discrete (≤ 20 levels) or continuous. \n\nBinary and discrete channels are commands/states and behave very differently from continuous measurements, which matters for scaling and for prediction error.","metadata":{}},{"cell_type":"code","source":"def read_hai(path):\n    d = pd.read_csv(path)\n    d.columns = [c.strip() for c in d.columns]\n    d[\"time\"] = pd.to_datetime(d[\"time\"])\n    for c in LABEL_COLS[1:]:\n        if c not in d.columns:\n            d[c] = 0\n    d[FEATURES] = d[FEATURES].astype(\"float32\")\n    return d\n\nraw = {f: read_hai(os.path.join(DATA_DIR, f)) for f in TRAIN_FILES + ALL_TEST}\ntrain_all = pd.concat([raw[f] for f in TRAIN_FILES], ignore_index=True)\ntest_all = pd.concat([raw[f] for f in ALL_TEST], ignore_index=True)\n\ndef feature_profile(d, cols):\n    rows = []\n    for c in cols:\n        s = d[c]; nu = int(s.nunique())\n        kind = \"constant\" if nu == 1 else \"binary\" if nu == 2 else \"discrete (≤20)\" if nu <= 20 else \"continuous\"\n        rows.append({\"feature\": c, \"process\": c[:2], \"n_unique\": nu, \"kind\": kind,\n                     \"min\": float(s.min()), \"max\": float(s.max()), \"mean\": float(s.mean()), \"std\": float(s.std())})\n    return pd.DataFrame(rows).set_index(\"feature\")\n\nprofile = feature_profile(train_all, FEATURES)\nassert train_all[FEATURES].select_dtypes(exclude=\"number\").shape[1] == 0, \"non-numeric feature found\"\ndisplay(pd.crosstab(profile[\"process\"], profile[\"kind\"], margins=True))\n\nax = pd.crosstab(profile[\"process\"], profile[\"kind\"]).plot(kind=\"bar\", stacked=True, figsize=(7, 3.5), edgecolor=\"white\")\nax.set(title=\"Channel types per process (training data)\", xlabel=\"\", ylabel=\"# channels\"); plt.xticks(rotation=0)\nplt.tight_layout(); plt.show()\ndisplay(profile.sort_values