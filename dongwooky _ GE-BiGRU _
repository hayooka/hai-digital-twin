rce":"## 12. Anomaly scores","metadata":{}},{"cell_type":"code","source":"# [patch] Anomaly scoring (MAE) and Butterworth low-pass filtering (your cell)\n# PATCH: weights path uses the model name; test scoring is timed (the paper reports inference time per sample, Table 6).\n# ==============================================================================\n# Cell 6: Anomaly Scoring (MAE) & Butterworth Low-Pass Filtering (Wn = 0.1)\n# ==============================================================================\n\nimport numpy as np\nimport torch\nfrom scipy.signal import butter, filtfilt\nfrom tqdm.auto import tqdm\n\n# Load final weights\nmodel.load_state_dict(\n    torch.load(MODEL_SAVE_PATH, map_location=DEVICE)\n)\nmodel.eval()\n\n\ndef compute_filtered_scores(model, loader, edge_index, device, desc):\n\n    errors_list = []\n\n    with torch.no_grad():\n\n        for batch_X, batch_Y in tqdm(loader, desc=desc):\n\n            batch_X = batch_X.to(device, non_blocking=True)\n            batch_Y = batch_Y.to(device, non_blocking=True)\n\n            preds = model(batch_X, edge_index)\n\n            # MAE per sample across the 79 channels\n            mae = torch.abs(preds - batch_Y).mean(dim=1).cpu().numpy()\n\n            errors_list.extend(mae)\n\n    raw_scores = np.array(errors_list)\n\n    # Butterworth Low-Pass Filter\n    b, a = butter(N=1, Wn=0.1, btype=\"low\")\n    smoothed_scores = filtfilt(b, a, raw_scores)\n\n    return smoothed_scores\n\n\nprint(\"Calculating & Filtering Anomaly Scores (Wn = 0.1)...\\n\")\n\nval_scores = compute_filtered_scores(\n    model, val_loader, edge_index, DEVICE, \"Validation\"\n)\n\nt_inf = time.time()\ntest_scores = compute_filtered_scores(\n    model, test_loader, edge_index, DEVICE, \"Testing\"\n)\ninference_ms_per_sample = 1000 * (time.time() - t_inf) / len(test_scores)\n\nprint(\n    f\"\\nDone! Validation Scores: {len(val_scores):,} | \"\n    f\"Test Scores: {len(test_scores):,} | inference {inference_ms_per_sample:.3f} ms/sample\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:03:32.695487Z","iopub.execute_input":"2026-11-04T14:03:32.695834Z","iopub.status.idle":"2026-11-04T14:03:45.430334Z","shell.execute_reply.started":"2026-11-04T14:03:32.695807Z","shell.execute_reply":"2026-11-04T14:03:45.429593Z"}},"outputs":[{"name":"stdout","text":"Calculating & Filtering Anomaly Scores (Wn = 0.1)...\n\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Validation:   0%|          | 0/85 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"8c795281a79b41599fc9b3b8b1a029d0"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Testing:   0%|          | 0/701 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"b9da9b3f31cc4c209786c651b99ab1cf"}},"metadata":{}},{"name":"stdout","text":"\nDone! Validation Scores: 43,162 | Test Scores: 358,648 | inference 0.031 ms/sample\n","output_type":"stream"}],"execution_count":104},{"cell_type":"markdown","source":"## 13. Threshold selection and evaluation (eTaPR)\n\nAs in the paper (Eq. 7) and the authors' `predict.py`, the threshold is the value on the **validation split** that maximises the **eTaPR F1** over 200 equally spaced candidates (the largest threshold within 0.01 of the best is used), then it is fixed and applied to the test split. Predictions are placed on full-length label sequences, with rows that have no prediction (the first 39 of each piece) set to 0.","metadata":{}},{"cell_type":"code","source":"import subprocess, sys\ntry:\n    from TaPR_pkg import etapr\nexcept ImportError:\n    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"opencv-python-headless\"], check=True)\n    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n                    \"https://raw.githubusercontent.com/wshw4ng/eTaPR/main/archieves/eTaPR-1.12-py3-none-any.whl\"], check=True)\n    from TaPR_pkg import etapr\nprint(\"eTaPR imported:\", etapr.__name__)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:03:45.431342Z","iopub.execute_input":"2026-11-04T14:03:45.431671Z","iopub.status.idle":"2026-11-04T14:03:45.437001Z","shell.execute_reply.started":"2026-11-04T14:03:45.431646Z","shell.execute_reply":"2026-11-04T14:03:45.436212Z"}},"outputs":[{"name":"stdout","text":"eTaPR imported: TaPR_pkg.etapr\n","output_type":"stream"}],"execution_count":105},{"cell_type":"code","source":"# [patch] Threshold locking (T*) with the 0.01 margin rule, and test evaluation (your cell 7 + cell 8)\n# PATCHES: the validation sweep maximises eTaPR F1 (yours used point-wise F1); predictions and labels are full-length\n#          sequences (window predictions placed at their target rows); eTaPR on test replaces the PyEtapr call.\n# ==============================================================================\n# Cell 7: Threshold Locking (T*) with 0.01 Margin Rule & Test Evaluation\n# ==============================================================================\n\nimport numpy as np\nfrom sklearn.metrics import confusion_matrix, precision_recall_fscore_support\nfrom tqdm.auto import tqdm\n\nassert len(val_scores) == len(val_target_idx) and len(test_scores) == len(test_target_idx)\n\ndef to_full_length(window_preds, target_idx, n_rows):\n    full = np.zeros(n_rows, dtype=np.int8)           # rows without a window prediction stay 0 (authors' fill_blank)\n    full[target_idx] = window_preds\n    return full\n\nval_attack = (val_labels > 0).astype(int)\ntest_attack = (test_labels > 0).astype(int)\n\n# 1. Search 200 candidate thresholds on validation, scoring each with eTaPR F1\ncandidates = np.linspace(\n    val_scores.min(),\n    val_scores.max(),\n    200\n)\n\nval_f1s = []\nfor th in tqdm(candidates, desc=\"Threshold sweep\"):\n    pred_full = to_full_length((val_scores > th).astype(int), val_target_idx, len(val_labels))\n    val_f1s.append(float(etapr.evaluate(anomalies=val_attack, predictions=pred_full)[\"f1\"]))\n\n\n# 2. Apply 0.01 F1-margin rule\nbest_val_f1 = max(val_f1s)\nbest_idx = max(i for i, f in enumerate(val_f1s) if f >= best_val_f1 - 0.01)\nT_star, val_f1_star = candidates[best_idx], val_f1s[best_idx]\n\nprint(\"=\" * 60)\nprint(\"       VALIDATION THRESHOLD LOCKING (T*)\")\nprint(\"=\" * 60)\nprint(f\"Maximum Validation eTaPR F1 : {best_val_f1:.4f}\")\nprint(f\"Locked Threshold (T*)       : {T_star:.6f}\")\nprint(f\"Validation eTaPR F1 at T*   : {val_f1_star:.4f}\")\n\n\n# 3. Final evaluation on the test set\ntest_preds = to_full_length((test_scores > T_star).astype(int), test_target_idx, len(test_labels))\n\nTaPR = etapr.evaluate(anomalies=test_attack, predictions=test_preds)\ntap, tar, etapr_f1 = float(TaPR[\"TaP\"]), float(TaPR[\"TaR\"]), float(TaPR[\"f1\"])\n\ntn, fp, fn, tp = confusion_matrix(test_attack, test_preds, labels=[0, 1]).ravel()\nsensitivity = tp / (tp + fn) if (tp + fn) > 0 else 0.0\nspecificity = tn / (tn + fp) if (tn + fp) > 0 else 0.0\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"          FINAL TEST EVALUATION RESULTS\")\nprint(\"=\" * 60)\nprint(f\"Locked Threshold (T*)             : {T_star:.6f}\")\nprint(f\"Time-series Aware Precision (TaP) : {tap:.4f}\")\nprint(f\"Time-series Aware Recall (TaR)    : {tar:.4f}\")\nprint(f\"eTaPR F1 Score                    : {etapr_f1:.4f}\")\nprint(f\"Sensitivity (TPR)                 : {sensitivity:.4f}\")\nprint(f\"Specificity (TNR)                 : {specificity:.4f}\")\nprint(f\"Detected anomalies                : {len(TaPR['Detected_Anomalies'])} of {int(test_attack[np.r_[True, np.diff(test_attack) == 1]].sum())}\")\nprint(f\"Confusion Matrix                  : TN={tn:,}, FP={fp:,}, FN={fn:,}, TP={tp:,}\")\nprint(\"=\" * 60)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:03:45.437924Z","iopub.execute_input":"2026-11-04T14:03:45.438179Z","iopub.status.idle":"20