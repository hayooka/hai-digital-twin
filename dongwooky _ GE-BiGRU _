gorical encoding | none needed | there are no categorical columns |\n| Duplicated sensor rows | **kept** | repeated vectors are normal in steady operation |\n| Outliers | **kept** | they may be genuine attacks (Section 5) |\n| Time gaps | **kept**; windows that would span a gap are dropped when windows are built (Section 8) | the paper keeps only windows with strictly contiguous timestamps |\n\n","metadata":{}},{"cell_type":"code","source":"PAPER_TO_CSV = {\"P2_AutoSD\": \"P2_ASD\", \"P3_LH01\": \"P3_LH\", \"P3_LL01\": \"P3_LL\"}\nprint({p: (c, c in FEATURES) for p, c in PAPER_TO_CSV.items()})\n\ndef clean_frame(d):\n    out = d.copy()\n    out.columns = [c.strip() for c in out.columns]\n    out[\"time\"] = pd.to_datetime(out[\"time\"])\n    if not out[\"time\"].is_monotonic_increasing:\n        out = out.sort_values(\"time\", kind=\"stable\")\n    out = out.drop_duplicates(subset=\"time\", keep=\"first\")\n    out[FEATURES] = out[FEATURES].astype(\"float32\").replace([np.inf, -np.inf], np.nan)\n    n_nan = int(out[FEATURES].isna().sum().sum())\n    if n_nan:\n        out[FEATURES] = out[FEATURES].ffill().bfill()\n    for c in LABEL_COLS[1:]:\n        if c not in out.columns:\n            out[c] = 0\n        out[c] = out[c].fillna(0).astype(\"int8\")\n    return out.reset_index(drop=True), n_nan\n\nlog = []\nfor n, d in raw.items():\n    c, n_nan = clean_frame(d)\n    log.append({\"file\": n, \"rows_in\": len(d), \"rows_out\": len(c), \"imputed_cells\": n_nan})\ndisplay(pd.DataFrame(log).set_index(\"file\"))\n\n# Release the big EDA frames (profile, oor and out_pct are kept for the feature-selection summary)\nimport gc\ndel raw, train_all, test_all, outside, corr\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T14:03:00.80151Z","iopub.execute_input":"2026-11-04T14:03:00.801868Z","iopub.status.idle":"2026-11-04T14:03:04.472254Z","shell.execute_reply.started":"2026-11-04T14:03:00.80184Z","shell.execute_reply":"2026-11-04T14:03:04.