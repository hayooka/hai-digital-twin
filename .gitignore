# Data files — never commit raw/processed data
00_data/
*.csv
*.parquet
*.h5
*.hdf5

# Large binary arrays
*.npy
*.npz
*.zip

# Serialised objects — exclude by default, but allow specific artifacts
*.pkl
*.pickle
# Allow the saved classifier and scaler so new clones have them out of the box
!outputs/classifiers/trts_rf_classifier.pkl
!outputs/classifiers/trts_rf_scaler.pkl

# Model checkpoints
*.pt
*.pth
*.ckpt
models/checkpoints/
runs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg

# Notebooks
.ipynb_checkpoints/

# Environments
.env
.venv/
env/
venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
